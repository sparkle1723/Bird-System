# ==================== Node.js / Vue / uni-app ====================
# Dependencies
node_modules/

# uni-app build output
unpackage/

# Build output
dist/
build/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lock files (optional, uncomment if needed)
# package-lock.json
# yarn.lock

# ==================== Python ====================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
.venv/
ENV/

# Distribution / packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# ==================== IDE / Editor ====================
# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# HBuilderX
.hbuilderx/

# ==================== OS Generated Files ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==================== Project Specific ====================
# Uploaded files (user generated content)
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/images/*
!backend/uploads/images/.gitkeep

# Database files
*.db
*.sqlite3

# Environment variables
.env
.env.local
.env.*.local

# Secrets
*.pem
*.key
credentials.json
secrets.json

# Temporary files
*.tmp
*.temp
*.log
logs/

# Cache
.cache/
*.cache

# ==================== Force Track Model Folder ====================
# 强制不忽略 model 文件夹下的所有内容，确保模型与数据都能提交
!model/
!model/**
# 但排除其中的自动生成的缓存与 IDE 配置
model/**/__pycache__/
model/**/.idea/
model/**/*.pyc
